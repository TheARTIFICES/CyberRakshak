# Dockerfile.worker
FROM python:3.11-slim

# === FIX 2: Install Docker Client (DooD pattern) ===
RUN apt-get update && apt-get install -y \
    apt-transport-https \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://download.docker.com/linux/debian/gpg | \
    gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
RUN echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian \
  $(lsb_release -cs) stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null
RUN apt-get update && apt-get install -y docker-ce-cli
# === END FIX 2 ===

# 2. Set up Python environment
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY . .

# 3. setup graph 
RUN pip install playwright
RUN playwright install --with-deps chromium

# 4. Run the pre-start script and then the worker
# CHANGED: Removed '-P solo' and added '--concurrency 4'
CMD python worker_prestart.py && celery -A app.worker.celery_app worker -B --loglevel=info --concurrency=4 -Q scans
